---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { menuDoSite } from '../lib/menu';
import PaginaPartes from '../components/paginas/PaginaPartes.astro';
import PaginaTexto from '../components/paginas/PaginaTexto.astro';
import PaginaTrechos from '../components/paginas/PaginaTrechos.astro';

export async function getStaticPaths() {
	const paginas = await getCollection('paginas');
	return paginas.map((pagina) => ({ params: { pagina: pagina.id }, props: { pagina } }));
}

interface Props {
	pagina: CollectionEntry<'paginas'>;
}

const { pagina } = Astro.props;
const menu = await menuDoSite(false);
---

<Base titulo={`${pagina.data.titulo} · ${site.nome}`} descricao={pagina.data.descricao} menu={menu}>
	{
		pagina.data.tipo === 'partes' ? (
			<PaginaPartes pagina={pagina as never} />
		) : pagina.data.tipo === 'trechos' ? (
			<PaginaTrechos pagina={pagina as never} />
		) : (
			<PaginaTexto pagina={pagina} />
		)
	}
</Base>
