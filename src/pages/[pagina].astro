---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import { site } from '../data/site';

export async function getStaticPaths() {
	const paginas = await getCollection('paginas');
	return paginas.map((pagina) => ({ params: { pagina: pagina.id }, props: { pagina } }));
}

interface Props {
	pagina: CollectionEntry<'paginas'>;
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
---

<Base titulo={`${pagina.data.titulo} · ${site.nome}`} descricao={pagina.data.descricao}>
	<article class="pagina">
		<a class="link-discreto" href="/">← Voltar para o início</a>
		<h1>{pagina.data.titulo}</h1>
		<div class="corpo"><Content /></div>
		<BotaoWhatsapp>Conversar no WhatsApp</BotaoWhatsapp>
	</article>
</Base>
