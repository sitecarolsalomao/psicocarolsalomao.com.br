---
import { site } from '../data/site';

// Umami Cloud, plano grátis: sem cookies e sem dado pessoal, por isso sem banner.
// A única conversão do site é o clique no WhatsApp, marcado com data-umami-event no BotaoWhatsapp.
const id = site.umami;
---

{id && <script defer src="https://cloud.umami.is/script.js" data-website-id={id} />}
