---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { ancoraDe } from '../../lib/texto';
import Foto from '../Foto.astro';
import IconeDesenhado from '../IconeDesenhado.astro';

interface Props {
	secao: CollectionEntry<'secoes'> & { data: { tipo: 'abordagem' } };
}

const { secao } = Astro.props;
const { Content } = await render(secao);
const { titulo, cards, foto, fotoAlt } = secao.data;
---

<section class="secao secao-abordagem" id={ancoraDe(secao.id)}>
	<div class="dentro">
		<div class="abordagem-topo">
			<div>
				{titulo && <h2>{titulo}</h2>}
				<div class="corpo"><Content /></div>
			</div>
			<div class="abordagem-arte"><Foto src={foto} alt={fotoAlt} lugar="abordagem" /></div>
		</div>
		<ul class="cards">
			{
				cards.map((card) => (
					<li class="card">
						<IconeDesenhado nome={card.icone} />
						<h3>{card.titulo}</h3>
						<p>{card.texto}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
