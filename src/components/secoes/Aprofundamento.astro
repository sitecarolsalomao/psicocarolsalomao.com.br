---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { ancoraDe } from './ancora';

interface Props {
	secao: CollectionEntry<'secoes'> & { data: { tipo: 'aprofundamento' } };
}

const { secao } = Astro.props;
const { Content } = await render(secao);
---

<section class="secao" id={ancoraDe(secao.id)}>
	{secao.data.titulo && <h2>{secao.data.titulo}</h2>}
	<div class="corpo"><Content /></div>
	<a class="link-seta" href={`/${secao.data.pagina.id}/`}>{secao.data.linkTexto}</a>
</section>
