---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { ancoraDe } from './ancora';

interface Props {
	secao: CollectionEntry<'secoes'> & { data: { tipo: 'quem-te-escuta' } };
}

const { secao } = Astro.props;
const { Content } = await render(secao);
const { titulo, apresentacao, foto, fotoAlt, trajetoria, formacoes, estudos } = secao.data;
---

<section class="secao quem" id={ancoraDe(secao.id)}>
	{foto && <Image class="quem-foto" src={foto} alt={fotoAlt ?? ''} width={480} />}
	<div>
		{titulo && <h2>{titulo}</h2>}
		<p class="quem-apresentacao">{apresentacao}</p>
		<details class="quem-trajetoria">
			<summary>{trajetoria}</summary>
			<div class="corpo"><Content /></div>
			{
				formacoes.length > 0 && (
					<>
						<h3>Formação</h3>
						<ul>{formacoes.map((item) => <li>{item}</li>)}</ul>
					</>
				)
			}
			{
				estudos.length > 0 && (
					<>
						<h3>Estudos complementares</h3>
						<ul>{estudos.map((item) => <li>{item}</li>)}</ul>
					</>
				)
			}
		</details>
	</div>
</section>
