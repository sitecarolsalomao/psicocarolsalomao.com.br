---
// O "Quem te escuta": a trajetória e a formação fechadas, nessa ordem, cada uma abrindo no próprio clique.
// No celular, o texto abre logo abaixo do botão. No computador, abre na largura toda, embaixo da foto, sem deixar vazio.
// A trajetória vem em blocos com rótulo ("#### " no corpo do arquivo), para quem bate o olho achar cada parte.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { ancoraDe, blocosDeTexto, comNegrito, separarFormacao } from '../../lib/texto';

interface Props {
	secao: CollectionEntry<'secoes'> & { data: { tipo: 'quem-te-escuta' } };
}

const { secao } = Astro.props;
const trechos = blocosDeTexto(secao.body);
const emBlocos = trechos.some((trecho) => trecho.rotulo);
const { Content } = await render(secao);
const { titulo, apresentacao, trajetoria, formacoes, foto, fotoAlt } = secao.data;
// O que vem entre parênteses no nome desce um nível: "Especialização em Terapia Sistêmica (Indivíduo, Conjugalidade e Família)".
const blocos = formacoes.map(separarFormacao).map(([nome, lugar]) => {
	const [curso = nome, detalhe] = nome.match(/^(.+) \((.+)\)$/)?.slice(1) ?? [];
	return { curso, detalhe, lugar };
});
---

<section class="secao secao-quem" id={ancoraDe(secao.id)}>
	<div class="dentro quem">
		<div class="quem-retrato">
			<Image class="quem-foto" src={foto} alt={fotoAlt} widths={[320, 640]} sizes="18rem" />
		</div>
		<div class="quem-texto">
			{titulo && <h2>{titulo}</h2>}
			<p class="quem-apresentacao">{apresentacao}</p>
		</div>
		<div class="quem-abas">
			<button class="quem-aba" type="button" aria-expanded="false" aria-controls="quem-trajetoria">{trajetoria}</button>
			{
				emBlocos ? (
					<div class="quem-painel quem-trajetoria" id="quem-trajetoria">
						{trechos.map((trecho) => (
							<section class={`quem-trecho${trecho.rotulo ? '' : ' quem-trecho-fecho'}`}>
								{trecho.rotulo && <h3>{trecho.rotulo}</h3>}
								{trecho.itens.map((item) =>
									'lista' in item ? (
										<ul>{item.lista?.map((linha) => <li>{linha}</li>)}</ul>
									) : (
										<p set:html={comNegrito(item.paragrafo ?? '')} />
									),
								)}
							</section>
						))}
					</div>
				) : (
					<div class="quem-painel corpo quem-colunas" id="quem-trajetoria"><Content /></div>
				)
			}
			<button class="quem-aba" type="button" aria-expanded="false" aria-controls="quem-formacao">Formação</button>
			<ul class="quem-painel quem-blocos" id="quem-formacao">
				{
					blocos.map(({ curso, detalhe, lugar }) => (
						<li>
							<span class="quem-bloco-curso">{curso}</span>
							{detalhe && <span class="quem-bloco-lugar">{detalhe}</span>}
							{lugar && <span class="quem-bloco-lugar">{lugar}</span>}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	// Fecha aqui, e não no HTML: sem JavaScript, os dois textos ficam abertos em vez de inacessíveis.
	document.querySelectorAll('.quem-aba').forEach((aba) => {
		const painel = document.getElementById(aba.getAttribute('aria-controls'));
		painel.hidden = true;
		aba.addEventListener('click', () => {
			const abrir = painel.hidden;
			painel.hidden = !abrir;
			aba.setAttribute('aria-expanded', abrir);
			// Se o botão estava no pé da tela, o texto abriria fora da vista.
			if (abrir && painel.getBoundingClientRect().top > innerHeight * 0.85) painel.scrollIntoView({ block: 'nearest' });
		});
	});
</script>
