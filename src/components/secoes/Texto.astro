---
// A seção de texto, com a citação em faixa própria logo antes dela, quando houver. A âncora do menu fica na citação,
// que é onde a seção começa para quem olha, e o texto ganha a sua, com "-texto".
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { ancoraDe } from '../../lib/texto';

interface Props {
	secao: CollectionEntry<'secoes'> & { data: { tipo: 'texto' } };
}

const { secao } = Astro.props;
const { Content } = await render(secao);
const { titulo, citacao, citacaoAutora } = secao.data;
const ancora = ancoraDe(secao.id);
---

{
	citacao && (
		<figure class="faixa-citacao" id={ancora}>
			<blockquote>{citacao}</blockquote>
			{citacaoAutora && <figcaption>{citacaoAutora}</figcaption>}
		</figure>
	)
}
<section class={`secao secao-${ancora}`} id={citacao ? `${ancora}-texto` : ancora}>
	<div class="dentro">
		{titulo && <h2>{titulo}</h2>}
		<div class="corpo"><Content /></div>
	</div>
</section>
